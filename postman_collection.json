      "name": "5. Purchases, Progress & Certificates",
      "item": [
        {
          "name": "1. Initiate Course Purchase (Student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}/purchase",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses",
